# ---------------------------------------------------------------------------
# Environment variables for bimainlucknow.com
# Copy this file to ".env.local" for local development, or add these in
# Vercel Project Settings -> Environment Variables for production/preview.
# Never commit a real ".env" or ".env.local" file to GitHub.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for SEO tags and sitemap.
NEXT_PUBLIC_SITE_URL=https://bimainlucknow.com

# --- Lead delivery -----------------------------------------------------
# Optional webhook URL that receives every lead-form submission as JSON.
# Point this at a Zapier / Make / Google Sheets / CRM webhook once you
# choose a lead-management tool. Leads are NOT stored anywhere until this
# is set - see BUSINESS_INFORMATION_NEEDED.md.
LEAD_WEBHOOK_URL=

# --- Analytics (optional, leave blank until you have real IDs) --------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code (the "content" value
# from the meta tag Search Console gives you), not the whole tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
